# Copier ce fichier en `.env` (base Neon `dev`) et en `.env.test` (base Neon `test`).
# Valeurs FICTIVES : ne jamais commiter les vraies.

# Connexion poolée (application). Neon : adresse qui contient « -pooler ».
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-exemple-pooler.ca-east-1.aws.neon.tech/neondb?sslmode=require"

# Connexion directe (migrations Prisma). Neon : même adresse sans « -pooler ».
# Le nom DIRECT_URL est également accepté pour les environnements existants.
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@ep-exemple.ca-east-1.aws.neon.tech/neondb?sslmode=require"

# Après copie, lancer `npm run security:setup` pour remplir la clé privée locale.
# Sur Netlify, ajouter une clé privée aléatoire de 32 caractères au minimum (scope Functions).
# Les tests utilisent leur propre valeur fictive, jamais cette clé.
RATE_LIMIT_SECRET=""

# Seulement dans `.env.test` : autorise les tests à vider la base. Jamais ailleurs.
# DATABASE_IS_TEST="true"

# Aucun compte organisateur n'est configuré ici : chaque compte se crée avec
# `npm run organizer:create -- --email … --name "…"` (mot de passe demandé à l'écran).

# Courriel : exemples fictifs, à remplacer uniquement dans l'environnement privé.
# Origine HTTPS publique de l'aperçu ou de production ; HTTP réservé à localhost.
SITE_URL="https://diner.example.test"
SMTP_HOST="smtp.example.test"
# 465 : TLS immédiat ; autres ports (587 recommandé) : STARTTLS obligatoire.
SMTP_PORT="587"
SMTP_USER="utilisateur-fictif"
SMTP_PASSWORD="motdepasse-fictif"
# Adresse seule (affichée au nom de « Dîner de Noël ») ou « Nom <adresse> » pour choisir le nom.
EMAIL_FROM="Dîner de Noël <reservations@example.test>"
