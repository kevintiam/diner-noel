{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "checkJs": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "scripts/**/*",
    "prisma/**/*.js",
    "netlify/**/*",
    "*.js",
    "*.mjs"
  ],
  "exclude": ["node_modules", ".next", "src/generated", "verifier-bmad.mjs"]
}
