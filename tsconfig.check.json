{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@prisma/client/runtime/query_compiler_fast_bg.postgresql.mjs": [
        "./src/types/prisma-query-compiler.d.ts"
      ],
      "@prisma/client/runtime/query_compiler_fast_bg.postgresql.wasm-base64.mjs": [
        "./src/types/prisma-wasm.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "prisma/**/*.js", "netlify/**/*", "*.js", "*.mjs"],
  "exclude": [
    "node_modules",
    ".next",
    "src/generated",
    "**/*.test.js",
    "**/*.test.jsx",
    "verifier-bmad.mjs"
  ]
}
